# ---------------------------------------------------------------------------
# LEGEND landing page — environment
#
# Copy to `.env.local` for development, and add the same two keys to the
# Vercel project settings (Production + Preview) before launch.
#
# These are the ONLY environment variables the project uses. There is no
# backend, database, CRM or form API — enquiries go to Google Forms.
# ---------------------------------------------------------------------------

# Form A — "Pitch Your Story to LEGEND" (editorial submissions)
NEXT_PUBLIC_STORY_FORM_URL=https://docs.google.com/forms/d/e/REPLACE_WITH_STORY_FORM_ID/viewform

# Form B — "Partner With LEGEND" (advertising / partnerships)
NEXT_PUBLIC_PARTNERSHIP_FORM_URL=https://docs.google.com/forms/d/e/REPLACE_WITH_PARTNERSHIP_FORM_ID/viewform

# Canonical production origin — used for metadataBase, canonical URL, sitemap
# and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://legendmagazine.in
